# Server & Storage
APP_ENV=development
DATA_DIR=./data
QDRANT_URL=
# Leave QDRANT_URL empty to run Qdrant in zero-config embedded local mode.
# In Docker Compose, this is set to http://qdrant:6333.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local LLM Runtime (Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Optional OpenAI-Compatible External Provider (leave blank for 100% local Ollama)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Model Overrides (leave blank to let Hardware Advisor auto-select)
OVERRIDE_TIER=
OVERRIDE_EMBEDDING_MODEL=
OVERRIDE_RERANKER_MODEL=
OVERRIDE_LLM_MODEL=

# Security & RAG Tuning
MAX_UPLOAD_BYTES=52428800
MAX_ARCHIVE_UNCOMPRESSED_BYTES=209715200
PARENT_CHUNK_SIZE=1400
CHILD_CHUNK_SIZE=350
CHILD_CHUNK_OVERLAP=60
HYBRID_TOP_K=25
RERANK_TOP_K=5
MAX_CRAG_RETRIES=1

# Air-Gapped / Offline Mode (set to 1 after models are cached locally)
HF_HUB_OFFLINE=0
